<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IF GO</title>
</head>
<body>
    {{if ge .FinalValue 80}}
        <h1>Goood!</h1>
    {{else if ge .FinalValue 60}}
        <h1>Try Again!</h1>
    {{else}}
        <h1>Nice Try!</h1>
    {{end}}
</body>
</html>