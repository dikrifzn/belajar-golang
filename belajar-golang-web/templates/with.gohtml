<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    {{with .Address}}
        <h1>{{.Street}}</h1>
        <h1>{{.City}}</h1>
    {{else}}
        <h1>Anda Tidak Punya Address!</h1>
    {{end}}
</body>
</html>