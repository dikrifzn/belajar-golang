<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    {{/*ini adalah contoh penggunaan komentar di template go*/}}
    {{range $index, $element := .Hobbies}}
        <h1>{{$index}} - {{$element}}</h1>
    {{else}}
        <h1>Anda Tidak Punya Hobby!</h1>
    {{end}}
</body>
</html>